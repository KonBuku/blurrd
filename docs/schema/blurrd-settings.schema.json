    "Region": {
      "description": "A screen region that can contain player names.\n\nThe detector regions are the gameplay HUD parts that blurrd finds by\nitself. [`Region::Manual`] marks boxes the user drew; they are always\napplied, whichever regions are enabled. World-space name tags above\nplayers' heads are out of scope and have no region.",
      "oneOf": [
        {
          "description": "Kill feed rows in the top right corner (killer and victim names).",
          "type": "string",
          "const": "KillFeed"
        },
        {
          "description": "ACE, clutch and similar banners in the top centre.",
          "type": "string",
          "const": "Banner"
        },
        {
          "description": "The voice-chat speaker list on the left.",
          "type": "string",
          "const": "VoiceChat"
        },
        {
          "description": "Sender names in the text chat on the left.",
          "type": "string",
          "const": "TextChat"
        },
        {
          "description": "A box drawn by the user.",
          "type": "string",
          "const": "Manual"
        }
      ]
    },
    "RegionSet": {
      "description": "A set of [`Region`]s.\n\nSerialised as a sorted array of region names, for example\n`[\"KillFeed\", \"Banner\"]`.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Region"
      }
    },
    "RegionSettings": {
      "description": "Which regions are blurred, and how.",
