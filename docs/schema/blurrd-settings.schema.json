        },
        "enabled": {
          "description": "Enabled detector regions.",
          "$ref": "#/$defs/RegionSet"
        },
        "keep_names": {
          "description": "Names that stay readable.",
          "$ref": "#/$defs/KeepNames"
        },
        "mode": {
          "description": "Box geometry mode.",
          "$ref": "#/$defs/Mode"
        }
      },
      "required": [
        "enabled",
        "mode",
        "keep_names",
        "chat_blur_message",
        "chat_blur_system"
      ]
    },
    "SolidColor": {
      "description": "Fill colour of [`BlurStyle::Solid`].",
