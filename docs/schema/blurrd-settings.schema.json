{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "blurrd-settings/1",
  "description": "The app settings file (`settings.json`, schema `blurrd-settings/1`).\n\nMissing fields take their defaults, so a settings file from an older\nrevision of the same major loads unchanged.",
  "type": "object",
  "properties": {
    "appearance": {
      "description": "Appearance.",
      "$ref": "#/$defs/Appearance",
      "default": {
        "reduce_motion": "System",
        "theme": "System",
        "timeline_thumbs": true,
        "ui_font_size": 14
      }
    },
    "defaults": {
      "description": "Defaults for new projects.",
      "$ref": "#/$defs/Defaults",
      "default": {
        "blur": {
          "feather": 1.5,
          "noise": true,
          "pad": [
            4,
            3
          ],
          "radius": 6,
          "strength": "Medium",
          "style": "PixelBlur"
        },
        "export": {
          "audio": "Copy",
          "codec": "Source",
          "container": "Source",
          "copy_subtitles": true,
          "encoder": "Auto",
          "keyframes": "MatchSource",
          "metadata": "Technical",
          "moov": "Reserve",
          "nvenc_sessions": "Auto",
          "output": {
            "folder": "NextToSource",
            "on_conflict": "AddNumber",
            "template": "{name}_blurrd"
          },
          "preset": 4,
          "rate": {
            "MatchSource": {
              "max_factor": 1.5
            }
          },
          "smart_render": false,
          "split_encode": "Auto",
          "ten_bit": "Auto",
          "trim": null
        },
        "regions": {
          "chat_blur_message": false,
          "chat_blur_system": true,
          "enabled": [
            "KillFeed",
            "Banner",
            "VoiceChat",
            "TextChat"
          ],
          "keep_names": {
            "names": [],
            "own_row": false
          },
          "mode": "Tight"
        },
        "verify": {
          "audit_output": "Off",
          "coverage": "Structure",
          "enabled": true,
          "full_frame_sample_ms": 500,
          "ignore_words": [],
          "min_conf": 0.5,
          "mode": "DetectAndFix"
        }
      }
    },
    "general": {
      "description": "General behaviour.",
      "$ref": "#/$defs/General",
      "default": {
        "confirm_remove_running": true,
        "notify": true,
        "open_folder_after_export": false,
        "restore_queue": true
      }
    },
    "privacy": {
      "description": "Privacy.",
      "$ref": "#/$defs/Privacy",
      "default": {
        "log_level": "Info"
      }
    },
    "processing": {
      "description": "Processing.",
      "$ref": "#/$defs/Processing",
      "default": {
        "encoder": "Auto",
        "gpu_luid": null,
        "hw_decode": "Auto",
        "nvenc_sessions": "Auto",
        "parallel_jobs": 1,
        "preview_quality": "Auto"
      }
    },
    "schema": {
      "description": "Always `blurrd-settings/1`.",
      "type": "string"
    },
    "shortcuts": {
      "description": "Keyboard shortcuts that differ from the defaults: action name to key.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "version": {
      "description": "Revision within the schema's major version.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "schema",
    "version"
  ],
  "$defs": {
    "Appearance": {
      "description": "Appearance settings.",
      "type": "object",
      "properties": {
        "reduce_motion": {
          "description": "Animation preference.",
          "$ref": "#/$defs/ReduceMotion",
          "default": "System"
        },
        "theme": {
          "description": "Colour theme.",
          "$ref": "#/$defs/Theme",
          "default": "System"
        },
        "timeline_thumbs": {
          "description": "Show thumbnails in the timeline.",
          "type": "boolean",
          "default": true
        },
        "ui_font_size": {
          "description": "Base UI font size in pixels, 12 to 16.",
          "type": "integer",
          "format": "uint8",
          "default": 14,
          "maximum": 255,
          "minimum": 0
        }
      }
    },
    "AudioMode": {
      "description": "What happens to the audio streams.",
      "oneOf": [
        {
          "description": "Copy every audio stream unchanged.",
          "type": "string",
          "const": "Copy"
        },
        {
          "description": "Re-encode to AAC at the given bit rate in kbit/s.",
          "type": "object",
          "properties": {
            "Aac": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "Aac"
          ]
        },
        {
          "description": "Drop audio.",
          "type": "string",
          "const": "Remove"
        }
      ]
    },
    "Audit": {
      "description": "Whether the rendered output is read again with OCR.",
      "oneOf": [
        {
          "description": "No output audit.",
          "type": "string",
          "const": "Off"
        },
        {
          "description": "Audit sampled frames.",
          "type": "string",
          "const": "Sampled"
        },
        {
          "description": "Audit every frame.",
          "type": "string",
          "const": "EveryFrame"
        }
      ]
    },
    "BlurParams": {
      "description": "Parameters of the blur applied to every box.",
      "type": "object",
      "properties": {
        "feather": {
          "description": "Width of the soft edge in reference pixels.",
          "type": "number",
          "format": "float"
        },
        "noise": {
          "description": "Whether to add deterministic noise inside the box.",
          "type": "boolean"
        },
        "pad": {
          "description": "Padding around each box in reference pixels, `(x, y)`. The soft edge\nlives in the padding; the unpadded box is always fully covered.",
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            }
          ]
        },
        "radius": {
          "description": "Corner radius in reference pixels.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "strength": {
          "description": "Block size.",
          "$ref": "#/$defs/Strength"
        },
        "style": {
          "description": "Look of the blur.",
          "$ref": "#/$defs/BlurStyle"
        }
      },
      "required": [
        "style",
        "strength",
        "pad",
        "radius",
        "feather",
        "noise"
      ]
    },
    "BlurStyle": {
      "description": "Look of the blur inside a box.",
      "oneOf": [
        {
          "description": "Pixelate, then smooth with a gaussian (the default).",
          "type": "string",
          "const": "PixelBlur"
        },
        {
          "description": "Gaussian blur on the downsampled box.",
          "type": "string",
          "const": "Gaussian"
        },
        {
          "description": "Hard pixel blocks.",
          "type": "string",
          "const": "Pixelate"
        },
        {
          "description": "A solid fill.",
          "type": "object",
          "properties": {
            "Solid": {
              "type": "object",
              "properties": {
                "color": {
                  "description": "The fill colour.",
                  "$ref": "#/$defs/SolidColor"
                }
              },
              "required": [
                "color"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Solid"
          ]
        }
      ]
    },
    "Codec": {
      "description": "Output video codec.",
      "oneOf": [
        {
          "description": "The source's codec (H.264, HEVC or AV1).",
          "type": "string",
          "const": "Source"
        },
        {
          "description": "H.264 / AVC.",
          "type": "string",
          "const": "H264"
        },
        {
          "description": "H.265 / HEVC.",
          "type": "string",
          "const": "Hevc"
        },
        {
          "description": "AV1.",
          "type": "string",
          "const": "Av1"
        }
      ]
    },
    "ConflictPolicy": {
      "description": "What to do when the output file already exists.",
      "oneOf": [
        {
          "description": "Append a number: `clip_blurrd (2).mp4`.",
          "type": "string",
          "const": "AddNumber"
        },
        {
          "description": "Replace the existing file (never the input).",
          "type": "string",
          "const": "Overwrite"
        },
        {
          "description": "Skip the export.",
          "type": "string",
          "const": "Skip"
        }
      ]
    },
    "Container": {
      "description": "Output container format.",
      "oneOf": [
        {
          "description": "The source's container.",
          "type": "string",
          "const": "Source"
        },
        {
          "description": "MP4.",
          "type": "string",
          "const": "Mp4"
        },
        {
          "description": "Matroska.",
          "type": "string",
          "const": "Mkv"
        },
        {
          "description": "QuickTime.",
          "type": "string",
          "const": "Mov"
        }
      ]
    },
    "Coverage": {
      "description": "Which frames the verification reads.",
      "oneOf": [
        {
          "description": "Every frame on which a HUD structure signal is on, plus one frame in\nfifteen elsewhere.",
          "type": "string",
          "const": "Structure"
        },
        {
          "description": "Every frame.",
          "type": "string",
          "const": "EveryFrame"
        }
      ]
    },
    "Defaults": {
      "description": "Defaults for new projects.",
      "type": "object",
      "properties": {
        "blur": {
          "description": "Blur parameters.",
          "$ref": "#/$defs/BlurParams",
          "default": {
            "feather": 1.5,
            "noise": true,
            "pad": [
              4,
              3
            ],
            "radius": 6,
            "strength": "Medium",
            "style": "PixelBlur"
          }
        },
        "export": {
          "description": "Export settings.",
          "$ref": "#/$defs/ExportSettings",
          "default": {
            "audio": "Copy",
            "codec": "Source",
            "container": "Source",
            "copy_subtitles": true,
            "encoder": "Auto",
            "keyframes": "MatchSource",
            "metadata": "Technical",
            "moov": "Reserve",
            "nvenc_sessions": "Auto",
            "output": {
              "folder": "NextToSource",
              "on_conflict": "AddNumber",
              "template": "{name}_blurrd"
            },
            "preset": 4,
            "rate": {
              "MatchSource": {
                "max_factor": 1.5
              }
            },
            "smart_render": false,
            "split_encode": "Auto",
            "ten_bit": "Auto",
            "trim": null
          }
        },
        "regions": {
          "description": "Region settings.",
          "$ref": "#/$defs/RegionSettings",
          "default": {
            "chat_blur_message": false,
            "chat_blur_system": true,
            "enabled": [
              "KillFeed",
              "Banner",
              "VoiceChat",
              "TextChat"
            ],
            "keep_names": {
              "names": [],
              "own_row": false
            },
            "mode": "Tight"
          }
        },
        "verify": {
          "description": "Verification settings.",
          "$ref": "#/$defs/VerifySettings",
          "default": {
            "audit_output": "Off",
            "coverage": "Structure",
            "enabled": true,
            "full_frame_sample_ms": 500,
            "ignore_words": [],
            "min_conf": 0.5,
            "mode": "DetectAndFix"
          }
        }
      }
    },
    "EncoderSetting": {
      "description": "Which encoder to use.",
      "oneOf": [
        {
          "description": "The fallback chain NVENC, AMF, Quick Sync, Media Foundation.",
          "type": "string",
          "const": "Auto"
        },
        {
          "description": "A specific FFmpeg encoder, for example `h264_nvenc`.",
          "type": "object",
          "properties": {
            "Named": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "Named"
          ]
        }
      ]
    },
    "ExportSettings": {
      "description": "Export settings.",
      "type": "object",
      "properties": {
        "audio": {
          "description": "Audio handling.",
          "$ref": "#/$defs/AudioMode"
        },
        "codec": {
          "description": "Output codec.",
          "$ref": "#/$defs/Codec"
        },
        "container": {
          "description": "Output container.",
          "$ref": "#/$defs/Container"
        },
        "copy_subtitles": {
          "description": "Copy subtitle streams.",
          "type": "boolean"
        },
        "encoder": {
          "description": "Encoder choice.",
          "$ref": "#/$defs/EncoderSetting"
        },
        "keyframes": {
          "description": "Keyframe placement.",
          "$ref": "#/$defs/KeyframePolicy"
        },
        "metadata": {
          "description": "Container metadata.",
          "$ref": "#/$defs/MetadataMode"
        },
        "moov": {
          "description": "Index placement for MP4/MOV.",
          "$ref": "#/$defs/MoovMode"
        },
        "nvenc_sessions": {
          "description": "Parallel NVENC sessions.",
          "$ref": "#/$defs/NvencSessions"
        },
        "output": {
          "description": "Output file naming.",
          "$ref": "#/$defs/OutputSettings"
        },
        "preset": {
          "description": "Encoder preset, 1 (fastest) to 7 (best quality).",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "rate": {
          "description": "Rate control.",
          "$ref": "#/$defs/RateControl"
        },
        "smart_render": {
          "description": "Stream-copy GOPs without boxes (not available in v0.1).",
          "type": "boolean"
        },
        "split_encode": {
          "description": "Split-frame encoding for HEVC and AV1.",
          "$ref": "#/$defs/Toggle"
        },
        "ten_bit": {
          "description": "10-bit output.",
          "$ref": "#/$defs/Toggle"
        },
        "trim": {
          "description": "Export only these frames, or the whole video.",
          "anyOf": [
            {
              "$ref": "#/$defs/FrameRange"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "codec",
        "encoder",
        "rate",
        "preset",
        "ten_bit",
        "split_encode",
        "nvenc_sessions",
        "keyframes",
        "smart_render",
        "audio",
        "copy_subtitles",
        "metadata",
        "container",
        "moov",
        "output"
      ]
    },
    "FrameRange": {
      "description": "An inclusive range of presentation frame indices, written as `[f0, f1]`.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      },
      "maxItems": 2,
      "minItems": 2
    },
    "General": {
      "description": "General behaviour.",
      "type": "object",
      "properties": {
        "confirm_remove_running": {
          "description": "Ask before removing a running job from the queue.",
          "type": "boolean",
          "default": true
        },
        "notify": {
          "description": "Show a notification when a job finishes.",
          "type": "boolean",
          "default": true
        },
        "open_folder_after_export": {
          "description": "Open the output folder after an export.",
          "type": "boolean",
          "default": false
        },
        "restore_queue": {
          "description": "Restore the queue after a restart.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "HwDecodeSetting": {
      "description": "Hardware decoding preference.",
      "oneOf": [
        {
          "description": "Choose per codec from a cached benchmark.",
          "type": "string",
          "const": "Auto"
        },
        {
          "description": "Prefer NVDEC.",
          "type": "string",
          "const": "Nvdec"
        },
        {
          "description": "Always decode on the CPU.",
          "type": "string",
          "const": "Software"
        }
      ]
    },
    "KeepNames": {
      "description": "Names that stay readable.\n\nA kept name applies to a whole track only if every read of the track\nmatches exactly (case-folded, confidence at least 0.9 on at least five\nframes), or if the track is the local player's own row. Never per frame.",
      "type": "object",
      "properties": {
        "names": {
          "description": "Names to keep. Excluded from exported presets by default.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "own_row": {
          "description": "Keep the local player's own row readable.",
          "type": "boolean"
        }
      },
      "required": [
        "own_row",
        "names"
      ]
    },
    "KeyframePolicy": {
      "description": "Where the output's keyframes go.",
      "oneOf": [
        {
          "description": "An IDR frame wherever the source has a keyframe, closed GOPs.",
          "type": "string",
          "const": "MatchSource"
        },
        {
          "description": "The encoder's own keyframe placement.",
          "type": "string",
          "const": "EncoderDefault"
        }
      ]
    },
    "LogLevel": {
      "description": "Log verbosity.",
      "oneOf": [
        {
          "description": "Errors only.",
          "type": "string",
          "const": "Error"
        },
        {
          "description": "Errors and warnings.",
          "type": "string",
          "const": "Warn"
        },
        {
          "description": "Normal operation (the default). Logs never contain OCR text.",
          "type": "string",
          "const": "Info"
        },
        {
          "description": "Details for bug reports.",
          "type": "string",
          "const": "Debug"
        },
        {
          "description": "Everything.",
          "type": "string",
          "const": "Trace"
        }
      ]
    },
    "Luid": {
      "description": "A Windows adapter LUID (locally unique identifier) of a GPU.\n\nAdapters are always chosen by LUID, never by index. Written as 16 hex\ndigits (`\"00000000000a1b2c\"`) because JavaScript numbers cannot hold every\n64-bit value.",
      "type": "string"
    },
    "MetadataMode": {
      "description": "Which container metadata is kept.",
      "oneOf": [
        {
          "description": "Only colour, rotation and timecode; recorder title, comment and\naccount tags are stripped.",
          "type": "string",
          "const": "Technical"
        },
        {
          "description": "Everything the source has.",
          "type": "string",
          "const": "All"
        }
      ]
    },
    "Mode": {
      "description": "How tightly boxes follow the names.",
      "oneOf": [
        {
          "description": "Boxes hug the names; low-confidence spans fall back to the whole name\nslot automatically.",
          "type": "string",
          "const": "Tight"
        },
        {
          "description": "Every name gets the union of its tight box and its slot box.",
          "type": "string",
          "const": "Safe"
        }
      ]
    },
    "MoovMode": {
      "description": "Where the MP4/MOV index (`moov`) is written.",
      "oneOf": [
        {
          "description": "Reserve space up front; fall back to a faststart rewrite if it is\ntoo small.",
          "type": "string",
          "const": "Reserve"
        },
        {
          "description": "Rewrite the file to move the index to the front.",
          "type": "string",
          "const": "Faststart"
        },
        {
          "description": "Write the index at the end.",
          "type": "string",
          "const": "AtEnd"
        }
      ]
    },
    "NvencSessions": {
      "description": "Number of parallel NVENC sessions within one export.",
      "oneOf": [
        {
          "description": "Two sessions for H.264 when the GPU supports them, otherwise one.",
          "type": "string",
          "const": "Auto"
        },
        {
          "description": "One session.",
          "type": "string",
          "const": "One"
        },
        {
          "description": "Two sessions.",
          "type": "string",
          "const": "Two"
        }
      ]
    },
    "OutputFolder": {
      "description": "Where output files go.",
      "oneOf": [
        {
          "description": "The source file's folder.",
          "type": "string",
          "const": "NextToSource"
        },
        {
          "description": "A fixed folder.",
          "type": "object",
          "properties": {
            "Folder": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "Folder"
          ]
        }
      ]
    },
    "OutputSettings": {
      "description": "Output file naming.",
      "type": "object",
      "properties": {
        "folder": {
          "description": "Output folder.",
          "$ref": "#/$defs/OutputFolder"
        },
        "on_conflict": {
          "description": "Behaviour when the file exists.",
          "$ref": "#/$defs/ConflictPolicy"
        },
        "template": {
          "description": "File name template without extension; `{name}` is the source's file\nstem.",
          "type": "string"
        }
      },
      "required": [
        "folder",
        "template",
        "on_conflict"
      ]
    },
    "PreviewQuality": {
      "description": "Resolution of the in-app preview.",
      "oneOf": [
        {
          "description": "Full resolution when the machine keeps up, otherwise reduced.",
          "type": "string",
          "const": "Auto"
        },
        {
          "description": "Always full resolution.",
          "type": "string",
          "const": "Full"
        },
        {
          "description": "Always the reduced proxy resolution.",
          "type": "string",
          "const": "Reduced"
        }
      ]
    },
    "Privacy": {
      "description": "Privacy settings.",
      "type": "object",
      "properties": {
        "log_level": {
          "description": "Log verbosity.",
          "$ref": "#/$defs/LogLevel",
          "default": "Info"
        }
      }
    },
    "Processing": {
      "description": "Processing settings.",
      "type": "object",
      "properties": {
        "encoder": {
          "description": "Encoder preference.",
          "$ref": "#/$defs/EncoderSetting",
          "default": "Auto"
        },
        "gpu_luid": {
          "description": "GPU to use, or the high-performance adapter if `None`.",
          "anyOf": [
            {
              "$ref": "#/$defs/Luid"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hw_decode": {
          "description": "Decoder preference.",
          "$ref": "#/$defs/HwDecodeSetting",
          "default": "Auto"
        },
        "nvenc_sessions": {
          "description": "NVENC sessions per export.",
          "$ref": "#/$defs/NvencSessions",
          "default": "Auto"
        },
        "parallel_jobs": {
          "description": "Jobs that run at the same time, 1 or 2.",
          "type": "integer",
          "format": "uint8",
          "default": 1,
          "maximum": 255,
          "minimum": 0
        },
        "preview_quality": {
          "description": "Preview resolution.",
          "$ref": "#/$defs/PreviewQuality",
          "default": "Auto"
        }
      }
    },
    "RateControl": {
      "description": "Rate control of the encoder.",
      "oneOf": [
        {
          "description": "Variable bit rate around the source's bit rate, capped at\n`max_factor` times the source.",
          "type": "object",
          "properties": {
            "MatchSource": {
              "type": "object",
              "properties": {
                "max_factor": {
                  "description": "Peak bit rate as a multiple of the source bit rate.",
                  "type": "number",
                  "format": "float"
                }
              },
              "required": [
                "max_factor"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "MatchSource"
          ]
        },
        {
          "description": "Constant quality.",
          "type": "object",
          "properties": {
            "Cq": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            }
          },
          "additionalProperties": false,
