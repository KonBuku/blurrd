{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "blurrd",
  "mainBinaryName": "blurrd",
  "identifier": "io.github.konbuku.blurrd",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cargo xtask stage-bundle && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "blurrd",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "backgroundColor": "#2b2b2b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://blurrd.localhost; img-src 'self' data: blob:; media-src 'self' http://asset.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://blurrd.localhost ws://localhost:1420; img-src 'self' data: blob:; media-src 'self' http://asset.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "KonBuku",
    "copyright": "Copyright 2026 Konrad (KonBuku)",
    "category": "Video",
    "shortDescription": "Blur player names in gameplay recordings",
    "resources": {
      "../../../target/installer-files/": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
