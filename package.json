{
  "name": "blurrd",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "cargo xtask stage-dlls && pnpm --filter @blurrd/desktop tauri dev",
    "build": "pnpm --filter @blurrd/desktop tauri build",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "lint:typography": "node scripts/check-typography.mjs",
    "fmt": "oxfmt && cargo fmt --all",
    "fmt:check": "oxfmt --check && cargo fmt --all --check",
    "changelog": "git-cliff --unreleased",
    "notices": "node scripts/licenses.mjs",
    "notices:check": "node scripts/licenses.mjs --check",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "git-cliff": "2.14.2",
    "lefthook": "2.2.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "smol-toml": "1.9.1"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.10.1"
}
